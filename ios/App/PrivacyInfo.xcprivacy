<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TuiLaoShi's privacy manifest. It must agree with ios/AppStore/privacy.md
  and the App Privacy answers in App Store Connect.

  Collected (only once the learner signs in with Apple, for sync):
  - the Apple user id (the "sub" of the identity token): the server's user key
  - study progress (review schedules, answers, saves, settings), kept per
    device on the server so the Mac and the iPhone share it
  Not collected: email (read once from the identity token to check the
  allow-list, never stored), the device name (the fixed label "iphone"),
  Claude prompts (this build sends none; the server relays them and keeps
  none), voice (speech recognition stays with Apple's framework).

  Required-reason APIs, from the Swift code and the gomobile framework's
  imported symbols (nm -u TuiLaoShiCore):
  - file timestamps (stat, fstat, lstat, futimes): the engine checks the
    wiki's and the progress files' modification times in the app container
  - system boot time (mach_absolute_time): the Go runtime's monotonic clock,
    for elapsed time inside the app
  - disk space (statfs, fstatfs): linked by Go's syscall table and SQLite's
    file layer, which asks the file system type of its own database; the
    app never reads or shows free space
  UserDefaults: not used by the Swift code or the framework.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
