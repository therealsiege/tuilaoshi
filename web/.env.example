# Copy to .env.local for `npm run dev`; set these in Vercel for deploys. Never commit values.

# Postgres connection string (Neon's pooled URL on Vercel). Unset outside production = in-memory store.
DATABASE_URL=
# Random secret, at least 32 characters, that signs our session and device tokens (HS256).
SESSION_SECRET=
# Bundle ID Apple puts in the identity token's audience. Default: com.therealsiege.tuilaoshi
APPLE_BUNDLE_ID=
# Comma-separated Apple user IDs (sub) or verified emails allowed to sign in.
ALLOW_LIST=
# Anthropic API key, used only on the server.
ANTHROPIC_API_KEY=
# Model for /api/claude. Default: claude-sonnet-5-5
CLAUDE_MODEL=
# Claude calls per user per UTC day. Default: 200
CLAUDE_DAILY_CAP=
# Largest sync upload, in bytes. Default: 4000000 (Vercel caps request bodies at 4.5 MB)
SYNC_MAX_BYTES=
